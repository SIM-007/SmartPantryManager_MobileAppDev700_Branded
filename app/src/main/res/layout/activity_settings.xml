<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pantry_background" android:scaleType="centerCrop" android:alpha="0.30" android:contentDescription="Fresh ingredients background" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_margin="12dp" android:background="@drawable/screen_overlay">
        <ImageView android:layout_width="match_parent" android:layout_height="105dp" android:src="@drawable/recipes_logo" android:scaleType="centerCrop" android:contentDescription="Recipes logo" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pantry Display Settings" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Choose whether expiry dates are shown in the pantry list." />
        <Switch android:id="@+id/switchExpiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show expiry dates" android:checked="true" android:paddingTop="20dp" />
        <Button android:id="@+id/btnSaveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save Settings" android:textColor="@color/white" android:background="@drawable/button_background" />
    </LinearLayout>
</FrameLayout>
