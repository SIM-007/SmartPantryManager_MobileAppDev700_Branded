<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/pantry_background" android:scaleType="centerCrop" android:alpha="0.30" android:contentDescription="Fresh ingredients background" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_margin="12dp" android:background="@drawable/screen_overlay">
            <ImageView android:layout_width="match_parent" android:layout_height="100dp" android:src="@drawable/recipes_logo" android:scaleType="centerCrop" android:contentDescription="Recipes logo" />
            <TextView android:id="@+id/txtTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add Ingredient" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/green_dark" android:layout_marginTop="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Enter an ingredient currently available in your pantry." />
            <EditText android:id="@+id/edtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Ingredient name" android:inputType="textCapSentences" />
            <EditText android:id="@+id/edtQuantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity" android:inputType="numberDecimal" />
            <EditText android:id="@+id/edtUnit" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Unit: g, kg, ml, l, pieces or can" android:inputType="text" />
            <EditText android:id="@+id/edtExpiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Expiry date (YYYY-MM-DD) - optional" android:inputType="text" />
            <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Save Ingredient" android:textColor="@color/white" android:background="@drawable/button_background" />
            <Button android:id="@+id/btnCancel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancel" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
